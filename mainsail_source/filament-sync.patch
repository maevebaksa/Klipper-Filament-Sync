+<template>
+    <div v-if="hasVisibleFilaments">
+        <v-divider class="mt-3 mb-0" />
+        <v-card-title class="text-h5">Filament Assignment</v-card-title>
+        <v-card-text class="pb-0">
+            <p class="body-2">Filament change count: {{ filament_change_count }}</p>
+            <v-row>
+                <v-col v-for="filament in visibleFilaments" :key="filament.index" class="filament-box">
+                    <div
+                        class="filament-type"
+                        :style="{ backgroundColor: filament.color, color: getTextColor(filament.color) }">
+                        {{ filament.type }} ({{ filament.used }} g)
+                    </div>
+                    <v-menu offset-y>
+                        <template #activator="{ on, attrs }">
+                            <v-btn
+                                v-bind="attrs"
+                                class="tool-button"
+                                :style="{
+                                    backgroundColor: selectedTools[filament.index]?.color,
+                                    color: getTextColor(selectedTools[filament.index]?.color ?? '#000000'),
+                                }"
+                                v-on="on">
+                                {{ selectedTools[filament.index]?.label || 'Select Tool' }}
+                            </v-btn>
+                        </template>
+                        <v-list>
+                            <v-list-item
+                                v-for="tool in toolOptions"
+                                :key="tool.value"
+                                :style="{ backgroundColor: tool.color, color: getTextColor(tool.color) }"
+                                @click="selectTool(tool, filament.index)">
+                                {{ tool.label }}
+                            </v-list-item>
+                        </v-list>
+                    </v-menu>
+                </v-col>
+            </v-row>
+        </v-card-text>
+        <v-divider />
+    </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, Prop, Watch } from 'vue-property-decorator'
+import BaseMixin from '@/components/mixins/base'
+import ToolchangerMixin from '@/components/mixins/toolchanger'
+import { convertStringToArray } from '@/plugins/helpers'
+import { FileStateGcodefile } from '@/store/files/types'
+
+interface FilamentAssignment {
+    color: string
+    index: number
+    type: string
+    used: number
+}
+
+interface ToolOption {
+    color: string
+    label: string
+    material: string
+    value: number
+}
+
+@Component
+export default class StartPrintDialogToolchanger extends Mixins(BaseMixin, ToolchangerMixin) {
+    @Prop({ required: true }) readonly file!: FileStateGcodefile
+    @Prop({ required: true }) readonly showDialog!: boolean
+
+    showChangeSpoolDialog = false
+    selectedTools: Array<ToolOption | null> = []
+    automaticMappingApplied = false
+
+    get filament_change_count(): number {
+        return this.file.filament_change_count ?? 0
+    }
+
+    get filaments(): FilamentAssignment[] {
+        const colors = this.file.filament_colors ?? []
+        const rawTypes = this.file.filament_type as string | string[] | undefined
+        const types = Array.isArray(rawTypes) ? rawTypes : convertStringToArray(rawTypes ?? '')
+        const used = this.file.filament_weights?.map(Number) ?? []
+
+        return colors.map((color: string, index: number) => ({
+            color,
+            index,
+            type: types[index] || 'Unknown',
+            used: used[index] || 0,
+        }))
+    }
+
+    get visibleFilaments(): FilamentAssignment[] {
+        return this.filaments.filter((filament) => filament.used > 0)
+    }
+
+    get toolOptions(): ToolOption[] {
+        const names = this.toolchangerToolNames ?? []
+        const materials = this.toolchangerFilamentTypes ?? []
+        const colors = this.toolchangerFilamentColors ?? []
+        if (materials.length < names.length || colors.length < names.length) return []
+        return names.map((name, index) => {
+            const material = materials[index] ?? 'Unknown'
+            return {
+                label: `${name.replace('tool', '').trim()} (${material})`,
+                material,
+                value: Number(name.match(/\d+/)?.[0] || 0),
+                color: colors[index] ?? '#000000',
+            }
+        })
+    }
+
+    get hasVisibleFilaments(): boolean {
+        // Stock ProForge has no SET_TOOL_MAPPING/RESET_TOOL_MAPPING API.
+        return !this.isProforge && this.visibleFilaments.length > 1
+    }
+
+    mounted(): void {
+        this.applyAutomaticMapping()
+    }
+
+    @Watch('showDialog')
+    onShowDialogChange(val: boolean): void {
+        this.automaticMappingApplied = false
+        if (val) this.applyAutomaticMapping()
+    }
+
+    @Watch('filaments', { deep: true })
+    onFilamentsChange(): void {
+        this.applyAutomaticMapping()
+    }
+
+    @Watch('toolOptions', { deep: true })
+    onToolOptionsChange(): void {
+        this.applyAutomaticMapping()
+    }
+
+    applyAutomaticMapping(): void {
+        const fileMetadataReady = this.visibleFilaments.every(
+            (filament) => filament.type.trim() !== '' && filament.type.trim().toUpperCase() !== 'UNKNOWN'
+        )
+        if (
+            !this.showDialog ||
+            !this.hasVisibleFilaments ||
+            !fileMetadataReady ||
+            this.automaticMappingApplied ||
+            this.toolOptions.length === 0
+        )
+            return
+        this.automaticMappingApplied = true
+        this.doSend('RESET_TOOL_MAPPING')
+        this.matchToolsToFilaments()
+        this.selectedTools.forEach((tool, index) => {
+            if (tool && this.filaments[index].used > 0) {
+                this.doSend(`SET_TOOL_MAPPING T=${index} TOOL=${tool.value}`)
+            }
+        })
+    }
+
+    matchToolsToFilaments(): void {
+        this.selectedTools = this.filaments.map((filament) => this.findBestToolMatch(filament))
+    }
+
+    selectTool(tool: ToolOption, index: number): void {
+        if (!this.hasVisibleFilaments) return
+        this.doSend(`SET_TOOL_MAPPING T=${index} TOOL=${tool.value}`)
+        this.selectedTools[index] = tool
+    }
+
+    findBestToolMatch(filament: { color: string; type: string }): ToolOption | null {
+        const material = filament.type.trim().toUpperCase()
+        const matchingTools = this.toolOptions.filter((tool) => tool.material.trim().toUpperCase() === material)
+        let bestMatch: ToolOption | null = matchingTools[0] ?? null
+        let bestScore = Infinity
+
+        matchingTools.forEach((tool) => {
+            const colorDistance = this.calculateColorDistance(filament.color, tool.color)
+            if (colorDistance < bestScore) {
+                bestScore = colorDistance
+                bestMatch = tool
+            }
+        })
+
+        return bestMatch
+    }
+
+    calculateColorDistance(color1: string, color2: string): number {
+        const rgb1 = this.hexToRgb(color1)
+        const rgb2 = this.hexToRgb(color2)
+
+        if (!rgb1 || !rgb2) return Infinity
+
+        return Math.sqrt(Math.pow(rgb1.r - rgb2.r, 2) + Math.pow(rgb1.g - rgb2.g, 2) + Math.pow(rgb1.b - rgb2.b, 2))
+    }
+
+    hexToRgb(hex: string): { r: number; g: number; b: number } | null {
+        const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})(?:[a-f\d]{2})?$/i.exec(hex)
+        return result
+            ? {
+                  r: parseInt(result[1], 16),
+                  g: parseInt(result[2], 16),
+                  b: parseInt(result[3], 16),
+              }
+            : null
+    }
+
+    getTextColor(backgroundColor: string): string {
+        const color = backgroundColor.charAt(0) === '#' ? backgroundColor.substring(1, 7) : backgroundColor
+        const r = parseInt(color.substring(0, 2), 16)
+        const g = parseInt(color.substring(2, 4), 16)
+        const b = parseInt(color.substring(4, 6), 16)
+        const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255
+        return luminance > 0.5 ? 'black' : 'white'
+    }
+}
+</script>
+
+<style scoped>
+.filament-box {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    border: 1px solid var(--v-border-base);
+    border-radius: 10px;
+    padding: 10px;
+    margin: 5px;
+    background-color: var(--v-background-base);
+    width: 100%;
+}
+
+.filament-type {
+    font-weight: bold;
+    margin-bottom: 5px;
+    padding: 5px 10px;
+    border-radius: 5px;
+    color: white;
+    width: 100%;
+    text-align: center;
+}
+
+.tool-button {
+    width: 100%;
+    text-align: center;
+    padding: 5px 10px;
+    border-radius: 5px;
+    color: white;
+}
+
+.column-header {
+    font-weight: bold;
+    text-align: center;
+}
+
+.filament-details {
+    display: flex;
+    flex-direction: column;
+}
+
+.headline {
+    font-size: 1.5em;
+    font-weight: bold;
+    margin-bottom: 10px;
+    text-align: left;
+}
+</style>
