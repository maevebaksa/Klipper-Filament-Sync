new file mode 100644
index 0000000..d57403a
--- /dev/null
+++ b/src/plugins/axiscope.ts
@@ -0,0 +1,66 @@
+export interface AxiscopeStatus {
+    automatic_xy?: boolean
+    xy_state?: string
+    camera_position?: Array<number | null>
+    safe_z?: number | null
+    check_tool?: number | null
+    check_position?: number[] | null
+    confirmation_ready?: boolean
+    confirmation_blocked?: string | null
+    camera_adjustment?: boolean
+    confirmed_tools?: number[]
+    xy_results?: Record<string, { offsets: number[]; name: string }>
+}
+
+export interface AxiscopeContext {
+    ready: boolean
+    busy: boolean
+    printing: boolean
+    homedAxes: string
+    mesh: string
+    tool: number
+    position: number[]
+    safeZ: number | null
+}
+
+export function axiscopeControls(status: AxiscopeStatus | undefined, context: AxiscopeContext) {
+    const supported = status?.automatic_xy === true
+    const connected = context.ready && !context.busy && !context.printing && supported
+    const pending = ['probing', 'awaiting_confirmation', 'measured'].includes(status?.xy_state ?? '')
+    const motion =
+        connected &&
+        ['x', 'y', 'z'].every((axis) => context.homedAxes.includes(axis)) &&
+        !context.mesh &&
+        context.safeZ !== null &&
+        Number.isFinite(context.safeZ)
+    const cameraReady =
+        status?.camera_position?.length === 3 &&
+        status.camera_position.every((value) => typeof value === 'number' && Number.isFinite(value))
+    const cameraClear = cameraReady && status!.camera_position![2]! <= context.safeZ!
+    const positionMatches =
+        !status?.check_position ||
+        status.check_position.every((value, index) => Math.abs(context.position[index] - value) <= 0.05)
+    const verificationReady = status?.confirmation_ready ?? positionMatches
+    const confirm =
+        motion &&
+        cameraClear &&
+        status?.xy_state === 'awaiting_confirmation' &&
+        status.check_tool != null &&
+        status.check_tool === context.tool &&
+        verificationReady
+    return {
+        query: connected,
+        capture: motion && !pending && context.tool === 0 && context.position[2] <= context.safeZ!,
+        saveCamera: motion && !pending && cameraClear,
+        calibrate: motion && !pending && cameraClear,
+        moveCamera: motion && cameraClear && status?.xy_state !== 'probing',
+        confirm,
+        adjust:
+            confirm &&
+            status?.camera_adjustment === true &&
+            status.check_tool !== 0 &&
+            !status.confirmed_tools?.includes(status.check_tool!),
+        discard: connected && pending && status?.xy_state !== 'probing',
+        cameraReady,
+    }
+}
diff --git a/src/plugins/proforge.ts b/src/plugins/proforge.ts
new file mode 100644
index 0000000..5125d51
--- /dev/null
+++ b/src/plugins/proforge.ts
@@ -0,0 +1,31 @@
+// Stock Makertech uses zero-based extruders but one-based physical pickup macros.
+import { PrinterState } from '@/store/printer/types'
+export type PrinterObjects = PrinterState
+
+export function proforgeTools(printer: PrinterObjects): number[] {
+    if (printer.toolchanger?.tool_names?.length || !printer['gcode_macro DOCK']) return []
+    const count = Number(printer.save_variables?.variables?.active_tools)
+    if (!Number.isInteger(count) || count < 1 || count > 5) return []
+    const tools = Array.from({ length: count }, (_, index) => index)
+    return tools.every((tool) => printer[`gcode_macro SELECT_PH${tool + 1}`] !== undefined) ? tools : []
+}
+
+export function proforgeActiveTool(printer: PrinterObjects): number {
+    if (printer['gcode_button carriage_tool_sensor']?.state !== 'PRESSED') return -1
+    const tools = proforgeTools(printer)
+    const missing = tools.filter((tool) => printer[`gcode_button t${tool}_dock_sensor`]?.state === 'RELEASED')
+    if (missing.length !== 1) return -1
+    if (!tools.every((tool) => ['PRESSED', 'RELEASED'].includes(printer[`gcode_button t${tool}_dock_sensor`]?.state)))
+        return -1
+    return missing[0]
+}
+
+export function filamentCommand(printer: PrinterObjects, tool: number, operation: 'load' | 'unload'): string {
+    const tools = proforgeTools(printer)
+    if (tools.length) {
+        if (!tools.includes(tool)) return ''
+        const macro = `_FILAMENT_${operation.toUpperCase()}_INIT_${tool}`
+        return printer[`gcode_macro ${macro}`] !== undefined ? macro : ''
+    }
+    return `${operation.toUpperCase()}_FILAMENT TOOLHEAD=${tool}`
+}
