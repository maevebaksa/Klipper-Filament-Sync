+                    <template #activator="{ on, attrs }">
+                        <div v-bind="attrs" v-on="on"></div>
+                    </template>
+                    <v-card>
+                        <v-color-picker v-model="draftColor" hide-mode-switch mode="hexa" />
+                        <v-card-actions>
+                            <v-btn text @click="cancelColorPicker">{{ $t('Buttons.Cancel') }}</v-btn>
+                            <v-spacer />
+                            <v-btn color="primary" text @click="saveColorPicker">{{ $t('Buttons.Save') }}</v-btn>
+                        </v-card-actions>
+                    </v-card>
+                </v-menu>
+            </div>
+            <v-select
+                v-model="draftMaterial"
+                class="filament-field"
+                :items="filamentTypes"
+                :label="$t('Panels.ToolchangerPanel.Material')"
+                @change="saveFilament" />
+            <v-row class="filament-temperatures" dense>
+                <v-col cols="6">
+                    <v-text-field
+                        v-model.number="draftNozzleTemp"
+                        :label="$t('Panels.ToolchangerPanel.NozzleTemperature')"
+                        type="number"
+                        min="0"
+                        max="350"
+                        suffix="°C"
+                        @change="saveFilament" />
+                </v-col>
+                <v-col cols="6">
+                    <v-text-field
+                        v-model.number="draftBedTemp"
+                        :label="$t('Panels.ToolchangerPanel.BedTemperature')"
+                        type="number"
+                        min="0"
+                        max="150"
+                        suffix="°C"
+                        @change="saveFilament" />
+                </v-col>
+            </v-row>
+            <v-text-field
+                v-if="hasToolchanger"
+                class="filament-field"
+                :value="pressureAdvance"
+                :label="$t('Panels.ToolchangerPanel.PressureAdvance')"
+                type="number"
+                step="0.01"
+                @change="savePressureAdvance" />
+        </div>
+
+        <div v-if="hasToolchanger" class="tool-buttons">
+            <v-btn
+                small
+                :disabled="printerIsPrintingOnly"
+                @click="isProforge ? loadFilament() : doSend(`LOAD_ONE_FILAMENT TOOL=${toolNumber} MATERIAL=${draftMaterial}`)">
+                <v-icon left small>{{ mdiRedoVariant }}</v-icon>
+                {{ $t('LOAD', { isDefault: '' }) }}
+            </v-btn>
+            <v-btn
+                small
+                :disabled="printerIsPrintingOnly"
+                @click="isProforge ? unloadFilament() : doSend(`UNLOAD_ONE_FILAMENT TOOL=${toolNumber} MATERIAL=${draftMaterial}`)">
+                <v-icon left small>{{ mdiUndoVariant }}</v-icon>
+                {{ $t('UNLOAD', { isDefault: '' }) }}
+            </v-btn>
+            <v-btn small :disabled="printerIsPrintingOnly" @click="doSend(tCommand)">
+                <v-icon left small>{{ mdiTargetVariant }}</v-icon>
+                {{ $t('ACTIVATE', { isDefault: '' }) }}
+            </v-btn>
+        </div>
+        <div v-else-if="hasProfileLoadUnload" class="tool-buttons">
+            <v-btn small :disabled="printerIsPrintingOnly || draftMaterial === 'EMPTY'" @click="loadFilament">
+                <v-icon left small>{{ mdiRedoVariant }}</v-icon>
+                {{ $t('LOAD', { isDefault: '' }) }}
+            </v-btn>
+            <v-btn small :disabled="printerIsPrintingOnly" @click="unloadFilament">
+                <v-icon left small>{{ mdiUndoVariant }}</v-icon>
+                {{ $t('UNLOAD', { isDefault: '' }) }}
+            </v-btn>
+        </div>
+    </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, Prop, Watch } from 'vue-property-decorator'
+import BaseMixin from '@/components/mixins/base'
+import ToolchangerMixin from '@/components/mixins/toolchanger'
+import { filamentCommand } from '@/plugins/proforge'
+import ExtruderMixin from '@/components/mixins/extruder'
+import { mdiUndoVariant, mdiRedoVariant, mdiTargetVariant, mdiPrinter3dNozzle } from '@mdi/js'
+
+@Component
+export default class ToolchangerPanel extends Mixins(BaseMixin, ExtruderMixin, ToolchangerMixin) {
+    @Prop({ type: String, required: true }) readonly name!: string
+    mdiUndoVariant = mdiUndoVariant
+    mdiRedoVariant = mdiRedoVariant
+    mdiTargetVariant = mdiTargetVariant
+    mdiPrinter3dNozzle = mdiPrinter3dNozzle
+    showColorPicker = false
+    draftColor = '#000000'
+    draftMaterial = 'EMPTY'
+    draftNozzleTemp = 0
+    draftBedTemp = 0
+
+    get filamentTypes(): string[] {
+        return Array.from(new Set(['EMPTY', ...this.toolchangerFilamentTypesOptions]))
+    }
+
+    get savedColor(): string {
+        return this.normalizeColor(this.toolchangerFilamentColors[this.toolNumber])
+    }
+
+    get savedMaterial(): string {
+        const material = String(this.toolchangerFilamentTypes[this.toolNumber] ?? '')
+            .trim()
+            .toUpperCase()
+        return ['', 'EMPTY', 'NONE', 'UNKNOWN', 'UNSET'].includes(material) ? 'EMPTY' : material
+    }
+
+    get savedNozzleTemp(): number {
+        return this.clampTemperature(this.toolchangerFilamentNozzleTemps[this.toolNumber], 350)
+    }
+
+    get savedBedTemp(): number {
+        return this.clampTemperature(this.toolchangerFilamentBedTemps[this.toolNumber], 150)
+    }
+
+    get hasToolchanger(): boolean {
+        return this.toolchangerToolNames.length > 0
+    }
+
+    get hasProfileLoadUnload(): boolean {
+        if (this.isProforge)
+            return !!filamentCommand(this.$store.state.printer, this.toolNumber, 'load') &&
+                !!filamentCommand(this.$store.state.printer, this.toolNumber, 'unload')
+        return (
+            this.$store.state.printer?.['gcode_macro LOAD_FILAMENT'] !== undefined &&
+            this.$store.state.printer?.['gcode_macro UNLOAD_FILAMENT'] !== undefined
+        )
+    }
+
+    get isActive(): boolean {
+        return this.toolchangerTool === this.name
+    }
+
+    get isChanging(): boolean {
+        return this.toolchangerStatus === 'changing'
+    }
+
+    get toolNumber(): number {
+        return Number(`${this.name.replace(/\D/g, '')}`)
+    }
+
+    get tCommand(): string {
+        if (this.isProforge) return `SELECT_PH${this.toolNumber + 1}`
+        return `T${this.toolNumber}`
+    }
+
+    get nozzleDiameter(): number {
+        return this.extruders[this.toolNumber]?.nozzleDiameter ?? this.extruders[0]?.nozzleDiameter ?? 0.4
+    }
+
+    get pressureAdvance(): number {
+        if (this.$store.state.printer?.[`gcode_macro ${this.tCommand}`]?.pressure_advance != null) {
+            return this.$store.state.printer?.[`gcode_macro ${this.tCommand}`]?.pressure_advance
+        } else {
+            const extruder = this.extruders[this.toolNumber] ?? this.extruders[0]
+            return this.$store.state.printer?.[extruder?.key]?.pressure_advance ?? 0
+        }
+    }
+
+    @Watch('savedColor', { immediate: true })
+    onSavedColorChange(value: string): void {
+        if (!this.showColorPicker) this.draftColor = value
+    }
+
+    @Watch('savedMaterial', { immediate: true })
+    onSavedMaterialChange(value: string): void {
+        this.draftMaterial = value
+    }
+
+    @Watch('savedNozzleTemp', { immediate: true })
+    onSavedNozzleTempChange(value: number): void {
+        this.draftNozzleTemp = value
+    }
+
+    @Watch('savedBedTemp', { immediate: true })
+    onSavedBedTempChange(value: number): void {
+        this.draftBedTemp = value
+    }
+
+    normalizeColor(value: unknown): string {
+        const color = String(value ?? '')
+            .trim()
+            .replace(/^#/, '')
+            .slice(0, 6)
+            .toUpperCase()
+        return /^[0-9A-F]{6}$/.test(color) ? `#${color}` : '#000000'
+    }
+
+    clampTemperature(value: unknown, maximum: number): number {
+        const temperature = Number.parseInt(String(value ?? 0), 10)
+        if (!Number.isFinite(temperature)) return 0
+        return Math.max(0, Math.min(maximum, temperature))
+    }
+
+    openColorPicker(): void {
+        this.draftColor = this.savedColor
+        this.showColorPicker = true
+    }
+
+    cancelColorPicker(): void {
+        this.draftColor = this.savedColor
+        this.showColorPicker = false
+    }
+
+    saveColorPicker(): void {
+        this.showColorPicker = false
+        this.saveFilament()
+    }
+
+    saveFilament(): void {
+        if (this.draftMaterial === 'EMPTY') {
+            this.doSend(`SET_TOOL_FILAMENT TOOL=${this.toolNumber} EMPTY=1 QUIET=1`)
+            return
+        }
+        const color = this.normalizeColor(this.draftColor).slice(1)
+        const nozzleTemp = this.clampTemperature(this.draftNozzleTemp, 350)
+        const bedTemp = this.clampTemperature(this.draftBedTemp, 150)
+        this.doSend(
+            `SET_TOOL_FILAMENT TOOL=${this.toolNumber} MATERIAL=${this.draftMaterial} COLOR=${color} ` +
+                `NOZZLE_TEMP=${nozzleTemp} BED_TEMP=${bedTemp} QUIET=1`
+        )
+    }
+
+    savePressureAdvance(value: string): void {
+        this.doSend(`SET_PRESSURE_ADVANCE TOOL=${this.toolNumber} VALUE=${value}`)
+    }
+
+    loadFilament(): void {
+        const command = filamentCommand(this.$store.state.printer, this.toolNumber, 'load')
+        if (command) this.doSend(command)
+    }
+
+    unloadFilament(): void {
+        const command = filamentCommand(this.$store.state.printer, this.toolNumber, 'unload')
+        if (command) this.doSend(command)
+    }
+}
+</script>
+
+<style scoped>
+.toolchanger-tool {
+    margin: 1%;
