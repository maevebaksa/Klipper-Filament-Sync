+
+<script lang="ts">
+import { Component, Mixins, Watch } from 'vue-property-decorator'
+import { mdiAdjust } from '@mdi/js'
+import BaseMixin from '@/components/mixins/base'
+import Panel from '@/components/ui/Panel.vue'
+import WebcamWrapper from '@/components/webcams/WebcamWrapper.vue'
+import { GuiWebcamStateWebcam } from '@/store/gui/webcams/types'
+import { AxiscopeStatus, axiscopeControls } from '@/plugins/axiscope'
+
+@Component({ components: { Panel, WebcamWrapper } })
+export default class ToolCalibrationPanel extends Mixins(BaseMixin) {
+    mdiAdjust = mdiAdjust
+    trimSteps = [
+        { label: 'X−', x: -0.05, y: 0 },
+        { label: 'X+', x: 0.05, y: 0 },
+        { label: 'Y−', x: 0, y: -0.05 },
+        { label: 'Y+', x: 0, y: 0.05 },
+    ]
+    busy = false
+    error = ''
+    statusLoaded = false
+    statusRequest = 0
+
+    get status(): AxiscopeStatus {
+        return this.$store.state.printer.axiscope ?? {}
+    }
+
+    get safeZ(): number | null {
+        const value = this.status.safe_z ?? this.$store.state.printer.configfile?.settings?.axiscope?.safe_z
+        return typeof value === 'number' && Number.isFinite(value) ? value : null
+    }
+
+    get controls() {
+        return axiscopeControls(this.status, {
+            ready: this.klipperReadyForGui && this.statusLoaded,
+            busy: this.busy,
+            printing: this.printerIsPrinting,
+            homedAxes: this.$store.state.printer.toolhead?.homed_axes ?? '',
+            mesh: this.$store.state.printer.bed_mesh?.profile_name ?? '',
+            tool: this.$store.state.printer.toolchanger?.tool_number ?? -1,
+            position: this.$store.state.printer.toolhead?.position ?? [],
+            safeZ: this.safeZ,
+        })
+    }
+
+    get pending(): boolean {
+        return ['probing', 'awaiting_confirmation', 'measured'].includes(this.status.xy_state ?? '')
+    }
+
+    get webcams(): GuiWebcamStateWebcam[] {
+        return (this.$store.getters['gui/webcams/getWebcams'] ?? []).filter(
+            (camera: GuiWebcamStateWebcam) => camera.enabled && camera.service !== 'grid'
+        )
+    }
+
+    get cameraName(): string {
+        return this.$store.state.gui.view.webcam.currentCam.toolcalibration ?? ''
+    }
+
+    get capturedCameraName(): string {
+        return this.$store.state.gui.view.webcam.currentCam['toolcalibration-reference'] ?? ''
+    }
+
+    get camera(): GuiWebcamStateWebcam | undefined {
+        const camera =
+            this.webcams.find((camera) => camera.name === this.cameraName) ??
+            this.webcams.find((camera) => /axiscope|calibrat/i.test(camera.name)) ??
+            this.webcams[0]
+        if (!camera) return undefined
+        return { ...camera, extra_data: { ...camera.extra_data, nozzleCrosshair: true } }
+    }
+
+    get cameraMatchesReference(): boolean {
+        return !this.capturedCameraName || this.camera?.name === this.capturedCameraName
+    }
+
+    get currentCameraName(): string {
+        return this.camera?.name ?? ''
+    }
+
+    set currentCameraName(name: string) {
+        this.$store.dispatch('gui/setCurrentWebcam', { page: 'toolcalibration', value: name })
+    }
+
+    get canCalibrate(): boolean {
+        return this.controls.calibrate && !!this.camera && this.cameraMatchesReference
+    }
+
+    get canConfirm(): boolean {
+        return this.controls.confirm && !!this.camera && this.cameraMatchesReference
+    }
+
+    get cameraTool(): number {
+        return this.status.check_tool ?? 0
+    }
+
+    get cameraPosition(): string {
+        return (this.status.camera_position ?? [null, null, null]).map(this.format).join(', ')
+    }
+
+    get results() {
+        return Object.entries(this.status.xy_results ?? {})
+            .map(([number, result]) => ({
+                number: Number(number),
+                offsets: result.offsets,
+                confirmed: this.status.confirmed_tools?.includes(Number(number)),
+            }))
+            .sort((a, b) => a.number - b.number)
+    }
+
+    get confirmLabel(): string {
+        const remaining = this.results.filter((result) => !result.confirmed).length
+        return remaining === 1 ? 'Panels.ToolCalibrationPanel.ConfirmSave' : 'Panels.ToolCalibrationPanel.ConfirmNext'
+    }
+
+    get stateText(): string {
+        const state = this.status.xy_state ?? 'idle'
+        const known = ['idle', 'probing', 'awaiting_confirmation', 'measured', 'saved', 'failed']
+        return this.$t('Panels.ToolCalibrationPanel.States.' + (known.includes(state) ? state : 'idle')).toString()
+    }
+
+    get hint(): string {
+        const prefix = 'Panels.ToolCalibrationPanel.'
+        if (!this.klipperReadyForGui) return this.$t(prefix + 'NotReady').toString()
+        if (!this.statusLoaded) return this.$t(prefix + 'Restoring').toString()
+        if (this.status.automatic_xy === undefined) return this.$t(prefix + 'UpgradeBackend').toString()
+        if (!this.status.automatic_xy) return this.$t(prefix + 'ConfigurePin').toString()
+        if (this.busy) return this.$t(prefix + 'Working').toString()
+        if (this.printerIsPrinting) return this.$t(prefix + 'Printing').toString()
+        if (this.safeZ === null) return this.$t(prefix + 'ConfigureSafeZ').toString()
+        const captureZ = this.$store.state.printer.toolhead?.position?.[2]
+        const cameraZ = this.status.camera_position?.[2]
+        const highZ = Math.max(captureZ ?? 0, cameraZ ?? 0)
+        if (highZ > this.safeZ)
+            return this.$t(prefix + 'HeightError', { z: this.format(highZ), safe: this.format(this.safeZ) }).toString()
+        if (this.$store.state.printer.toolhead?.homed_axes !== 'xyz') return this.$t(prefix + 'HomeFirst').toString()
+        if (this.$store.state.printer.bed_mesh?.profile_name) return this.$t(prefix + 'ClearMesh').toString()
+        if (!this.cameraMatchesReference) return this.$t(prefix + 'CameraChanged').toString()
+        if (this.status.xy_state === 'awaiting_confirmation' && !this.controls.confirm)
+            return this.$t(prefix + 'ReturnToCamera', { tool: this.cameraTool }).toString()
+        return ''
+    }
+
+    @Watch('klipperReadyForGui', { immediate: true })
+    onReady(ready: boolean): void {
+        this.statusLoaded = false
+        if (ready) void this.refreshStatus()
+        else this.statusRequest++
+    }
+
+    beforeDestroy(): void {
+        this.statusRequest++
+    }
+
+    async refreshStatus(): Promise<void> {
+        const request = ++this.statusRequest
+        this.statusLoaded = false
+        try {
+            const result = await this.$socket.emitAndWait('printer.objects.query', {
+                objects: { axiscope: null, toolhead: null, toolchanger: null, bed_mesh: null },
+            })
+            if (request !== this.statusRequest || !this.klipperReadyForGui) return
+            await this.$store.dispatch('printer/getData', result)
+            this.statusLoaded = true
+        } catch (error) {
+            if (request !== this.statusRequest) return
+            const message = typeof error === 'object' && error !== null && 'message' in error ? error.message : error
+            this.error =
+                typeof message === 'string' ? message : this.$t('Panels.ToolCalibrationPanel.RestoreFailed').toString()
+        }
+    }
+
+    rememberCamera(name: string): void {
+        this.currentCameraName = name
+        this.$store.dispatch('gui/setCurrentWebcam', { page: 'toolcalibration-reference', value: name })
+    }
+
+    async adjust(x: number, y: number): Promise<void> {
+        if (!this.controls.adjust || !this.camera || !this.cameraMatchesReference) return
+        await this.send('AXISCOPE_ADJUST_CAMERA X=' + x + ' Y=' + y)
+    }
+
+    format(value: number | null | undefined): string {
+        return typeof value === 'number' && Number.isFinite(value) ? value.toFixed(3) : '—'
+    }
+
+    async capture(): Promise<void> {
+        if (!this.controls.capture || !this.camera) return
+        const cameraName = this.camera.name
+        if (await this.send('AXISCOPE_SET_CAMERA_POSITION CURRENT=1')) this.rememberCamera(cameraName)
+    }
+
+    async calibrate(): Promise<void> {
+        if (!this.canCalibrate) return
+        this.rememberCamera(this.camera!.name)
+        await this.send('CALIBRATE_ALL_XY_OFFSETS CAMERA_CHECK=1 SAVE=1 INCLUDE_Z=0')
+    }
+
+    async send(script: string): Promise<boolean> {
+        if (this.busy || !this.klipperReadyForGui || this.printerIsPrinting) return false
+        this.busy = true
+        this.error = ''
+        try {
+            this.$store.dispatch('server/addEvent', { message: script, type: 'command' })
+            await this.$socket.emitAndWait('printer.gcode.script', { script })
+            return true
+        } catch (error) {
+            const message = typeof error === 'object' && error !== null && 'message' in error ? error.message : error
+            this.error =
+                typeof message === 'string' && message
+                    ? message
+                    : this.$t('Panels.ToolCalibrationPanel.CommandFailed').toString()
+            return false
+        } finally {
+            await this.refreshStatus()
+            this.busy = false
+        }
+    }
+}
+</script>
diff --git a/src/components/panels/Toolchanger/ToolchangerPanelTools.vue b/src/components/panels/Toolchanger/ToolchangerPanelTools.vue
new file mode 100644
index 0000000..74e926d
--- /dev/null
+++ b/src/components/panels/Toolchanger/ToolchangerPanelTools.vue
@@ -0,0 +1,51 @@
+<template>
+    <div class="mb-3">
+        <v-row v-for="(row, index) in rows" :key="'row_' + index" class="mt-0" dense no-gutters>
+            <v-col v-for="name in row" :key="name" :style="columnStyle" class="pa-1">
+                <toolchanger-panel-tools-item :name="name" />
+            </v-col>
+        </v-row>
+    </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import BaseMixin from '@/components/mixins/base'
+import ToolchangerMixin from '@/components/mixins/toolchanger'
+
+@Component({})
+export default class ToolchangerPanel extends Mixins(BaseMixin, ToolchangerMixin) {
+    get displayToolNames(): string[] {
+        if (this.toolchangerToolNames.length > 0) return this.toolchangerToolNames
+        if (this.filamentToolCount === 1) return ['extruder']
+        return Array.from({ length: this.filamentToolCount }, (_unused, index) => `tool T${index}`)
+    }
+
+    get rows(): string[][] {
+        const len = this.displayToolNames.length
+        const cols = Math.ceil(len / Math.ceil(len / 5))
+        const rows: string[][] = []
+
+        for (let i = 0; i < len; i += cols) {
+            rows.push(this.displayToolNames.slice(i, i + cols))
+        }
+
+        return rows
+    }
+
+    get columnStyle(): string {
+        return `max-width: ${100 / Math.min(this.displayToolNames.length, 5)}%`
+    }
+}
+</script>
+
+<style scoped>
+._tool-group {
+    border-radius: 4px;
+    display: inline-flex;
+    flex-wrap: nowrap;
+    max-width: 100%;
+    min-width: 100%;
+    margin: auto;
+}
+</style>
