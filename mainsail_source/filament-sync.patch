@@ -0,0 +1,67 @@
+import Vue from 'vue'
+import Component from 'vue-class-component'
+
+@Component
+export default class ToolchangerMixin extends Vue {
+    get enabled(): boolean {
+        return true
+    }
+    get toolchangerStatus(): string {
+        return this.$store.state.printer.toolchanger?.status
+    }
+
+    get toolchangerTool(): string {
+        return this.$store.state.printer.toolchanger?.tool
+    }
+
+    get toolchangerToolNumber(): number {
+        return this.$store.state.printer.toolchanger?.tool_number
+    }
+
+    get toolchangerToolNumbers(): number[] {
+        return this.$store.state.printer.toolchanger?.tool_numbers ?? []
+    }
+
+    get toolchangerToolNames(): string[] {
+        return this.$store.state.printer.toolchanger?.tool_names ?? []
+    }
+
+    get toolchangerFilamentTypes(): string[] {
+        const types = this.$store.state.printer.save_variables?.variables?.filament_types
+        return Array.isArray(types) ? types : []
+    }
+
+    get toolchangerFilamentTypesOptions(): string[] {
+        const options = this.$store.state.printer.save_variables?.variables?.filament_types_options
+        return Array.isArray(options) ? options : ['PLA', 'ABS', 'ASA', 'PETG', 'PA', 'PC', 'TPU']
+    }
+
+    get toolchangerFilamentColors(): string[] {
+        const colors = this.$store.state.printer.save_variables?.variables?.filament_colors
+        return Array.isArray(colors) ? colors : []
+    }
+
+    get toolchangerFilamentNozzleTemps(): number[] {
+        const temperatures = this.$store.state.printer.save_variables?.variables?.filament_nozzle_temps
+        return Array.isArray(temperatures) ? temperatures.map(Number) : []
+    }
+
+    get toolchangerFilamentBedTemps(): number[] {
+        const temperatures = this.$store.state.printer.save_variables?.variables?.filament_bed_temps
+        return Array.isArray(temperatures) ? temperatures.map(Number) : []
+    }
+
+    get filamentToolCount(): number {
+        const savedCount = Number(this.$store.state.printer.save_variables?.variables?.filament_tool_count ?? 0)
+        return Math.max(savedCount, this.toolchangerFilamentTypes.length, this.toolchangerFilamentColors.length, 1)
+    }
+
+    get toolMapping(): number[] {
+        return this.$store.state.printer.save_variables?.variables?.tool_map
+    }
+
+    doSend(gcode: string) {
+        this.$store.dispatch('server/addEvent', { message: gcode, type: 'command' })
+        this.$socket.emit('printer.gcode.script', { script: gcode })
+    }
+}
