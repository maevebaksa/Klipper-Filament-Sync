diff --git a/tests/axiscope.spec.ts b/tests/axiscope.spec.ts
new file mode 100644
index 0000000..5a82fdc
--- /dev/null
+++ b/tests/axiscope.spec.ts
@@ -0,0 +1,244 @@
+import { describe, expect, it, vi } from 'vitest'
+import { axiscopeControls, AxiscopeContext, AxiscopeStatus } from '../src/plugins/axiscope'
+import ToolCalibrationPanel from '../src/components/panels/ToolCalibrationPanel.vue'
+
+const ready: AxiscopeContext = {
+    ready: true,
+    busy: false,
+    printing: false,
+    homedAxes: 'xyz',
+    mesh: '',
+    tool: 0,
+    position: [100, 100, 30],
+    safeZ: 40,
+}
+const idle: AxiscopeStatus = { automatic_xy: true, xy_state: 'idle', camera_position: [100, 100, 30] }
+
+describe('Axiscope calibration controls', () => {
+    it('requires a compatible backend, homing, clearance and an idle printer', () => {
+        expect(axiscopeControls(undefined, ready).calibrate).toBe(false)
+        expect(axiscopeControls({}, ready).capture).toBe(false)
+        expect(axiscopeControls({ ...idle, automatic_xy: false }, ready).query).toBe(false)
+        for (const change of [
+            { ready: false },
+            { busy: true },
+            { printing: true },
+            { homedAxes: 'xy' },
+            { mesh: 'default' },
+            { safeZ: null },
+            { safeZ: Number.NaN },
+        ]) {
+            expect(axiscopeControls(idle, { ...ready, ...change }).calibrate).toBe(false)
+            expect(axiscopeControls(idle, { ...ready, ...change }).confirm).toBe(false)
+        }
+        expect(axiscopeControls(idle, ready).calibrate).toBe(true)
+    })
+
+    it('captures only physical T0 at or below the safe height, outside pending calibration', () => {
+        expect(axiscopeControls(idle, ready).capture).toBe(true)
+        expect(axiscopeControls(idle, { ...ready, tool: 2 }).capture).toBe(false)
+        expect(axiscopeControls(idle, { ...ready, safeZ: 20 }).capture).toBe(false)
+        expect(axiscopeControls({ ...idle, xy_state: 'measured' }, ready).capture).toBe(false)
+    })
+
+    it('rejects unset, nonfinite and excessive camera heights', () => {
+        for (const camera of [[null, null, null], [100, 100, Infinity], [100, 100, 50], []]) {
+            const controls = axiscopeControls({ ...idle, camera_position: camera }, ready)
+            expect(controls.calibrate).toBe(false)
+            expect(controls.saveCamera).toBe(false)
+            expect(controls.moveCamera).toBe(false)
+        }
+    })
+
+    it('confirms only the requested physical tool at the verification position', () => {
+        const verifying = { ...idle, xy_state: 'awaiting_confirmation', check_tool: 2, check_position: [100, 100, 30] }
+        expect(axiscopeControls(verifying, ready).confirm).toBe(false)
+        expect(axiscopeControls(verifying, { ...ready, tool: 2 }).confirm).toBe(true)
+        expect(axiscopeControls(verifying, { ...ready, tool: 2, position: [101, 100, 30] }).confirm).toBe(false)
+        expect(axiscopeControls({ ...verifying, check_tool: null }, ready).confirm).toBe(false)
+        expect(axiscopeControls({ ...verifying, xy_state: 'measured' }, ready).confirm).toBe(false)
+    })
+
+    it('uses current backend verification after reload and preserves position safety', () => {
+        const verifying = {
+            ...idle,
+            xy_state: 'awaiting_confirmation',
+            check_tool: 2,
+            check_position: [100, 100, 30],
+            confirmation_ready: true,
+            camera_adjustment: true,
+        }
+        const context = { ...ready, tool: 2, position: [] }
+        expect(axiscopeControls(verifying, context).confirm).toBe(true)
+        expect(axiscopeControls(verifying, context).adjust).toBe(true)
+        expect(axiscopeControls({ ...verifying, confirmation_ready: false }, context).confirm).toBe(false)
+        expect(axiscopeControls({ ...verifying, check_tool: 0 }, ready).adjust).toBe(false)
+        expect(axiscopeControls({ ...verifying, confirmed_tools: [2] }, context).adjust).toBe(false)
+        expect(axiscopeControls({ ...verifying, camera_adjustment: false }, context).adjust).toBe(false)
+    })
+
+    it('does not allow discarding a probe operation while its command is executing', () => {
+        expect(axiscopeControls({ ...idle, xy_state: 'probing' }, ready).discard).toBe(false)
+        expect(axiscopeControls({ ...idle, xy_state: 'awaiting_confirmation' }, ready).discard).toBe(true)
+        expect(axiscopeControls({ ...idle, xy_state: 'awaiting_confirmation' }, { ...ready, busy: true }).discard).toBe(
+            false
+        )
+    })
+})
+
+describe('Axiscope uses the connected Mainsail socket', () => {
+    const createContext = () => ({
+        busy: false,
+        klipperReadyForGui: true,
+        printerIsPrinting: false,
+        error: '',
+        refreshStatus: vi.fn().mockResolvedValue(undefined),
+        $store: { dispatch: vi.fn() },
+        $socket: { emitAndWait: vi.fn().mockResolvedValue('ok') },
+        $t: (key: string) => key,
+    })
+    type CommandContext = ReturnType<typeof createContext>
+    const component = ToolCalibrationPanel as unknown as {
+        options: { methods: { send: (this: CommandContext, script: string) => Promise<boolean> } }
+    }
+    const send = component.options.methods.send
+
+    it('sends calibration over the existing Moonraker transport and logs it', async () => {
+        const context = createContext()
+        const script = 'CALIBRATE_ALL_XY_OFFSETS CAMERA_CHECK=1 SAVE=1 INCLUDE_Z=0'
+        expect(await send.call(context, script)).toBe(true)
+        expect(context.$socket.emitAndWait).toHaveBeenCalledExactlyOnceWith('printer.gcode.script', { script })
+        expect(context.$store.dispatch).toHaveBeenCalledWith('server/addEvent', { message: script, type: 'command' })
+        expect(context.busy).toBe(false)
+        expect(context.refreshStatus).toHaveBeenCalledOnce()
+    })
+
+    it('blocks overlapping commands, printing and disconnected operation', async () => {
+        for (const change of [{ busy: true }, { printerIsPrinting: true }, { klipperReadyForGui: false }]) {
+            const context = { ...createContext(), ...change }
+            expect(await send.call(context, 'AXISCOPE_CONFIRM_TOOL')).toBe(false)
+            expect(context.$socket.emitAndWait).not.toHaveBeenCalled()
+        }
+        const context = createContext()
+        let resolve: (value: string) => void = () => {}
+        context.$socket.emitAndWait.mockReturnValue(
+            new Promise((done) => {
+                resolve = done
+            })
+        )
+        const first = send.call(context, 'AXISCOPE_CONFIRM_TOOL')
+        expect(await send.call(context, 'AXISCOPE_CONFIRM_TOOL')).toBe(false)
+        resolve('ok')
+        expect(await first).toBe(true)
+        expect(context.$socket.emitAndWait).toHaveBeenCalledTimes(1)
+    })
+
+    it('shows Moonraker command errors and releases the pending lock', async () => {
+        const context = createContext()
+        context.$socket.emitAndWait.mockRejectedValue({ message: 'Camera Z 30.000 exceeds safe_z 20.000' })
+        expect(await send.call(context, 'AXISCOPE_SET_CAMERA_POSITION CURRENT=1')).toBe(false)
+        expect(context.error).toBe('Camera Z 30.000 exceeds safe_z 20.000')
+        expect(context.busy).toBe(false)
+    })
+})
+
+describe('Axiscope restores the page from printer and persistent camera state', () => {
+    const options = (
+        ToolCalibrationPanel as unknown as {
+            options: {
+                methods: Record<string, (...args: any[]) => any>
+                computed: Record<string, { get: (...args: any[]) => any; set?: (...args: any[]) => any }>
+            }
+        }
+    ).options
+    const freshPage = () => ({
+        klipperReadyForGui: true,
+        statusLoaded: false,
+        statusRequest: 0,
+        error: '',
+        $socket: {
+            emitAndWait: vi.fn().mockResolvedValue({
+                status: {
+                    axiscope: { ...idle, xy_state: 'awaiting_confirmation', check_tool: 2, confirmed_tools: [0] },
+                    toolhead: { homed_axes: 'xyz', position: [100, 100, 30] },
+                    toolchanger: { tool_number: 2 },
+                },
+            }),
+        },
+        $store: {
+            dispatch: vi.fn().mockResolvedValue(undefined),
+            state: {
+                gui: {
+                    view: {
+                        webcam: {
+                            currentCam: {
+                                toolcalibration: 'Calibration camera',
+                                'toolcalibration-reference': 'Calibration camera',
+                            },
+                        },
+                    },
+                },
+            },
+        },
+        $t: (key: string) => key,
+    })
+
+    it('queries pending check and tool position on a fresh page without issuing any movement', async () => {
+        const context = freshPage()
+        await options.methods.refreshStatus.call(context)
+        expect(context.$socket.emitAndWait).toHaveBeenCalledExactlyOnceWith('printer.objects.query', {
+            objects: { axiscope: null, toolhead: null, toolchanger: null, bed_mesh: null },
+        })
+        expect(context.$store.dispatch).toHaveBeenCalledWith(
+            'printer/getData',
+            expect.objectContaining({
+                status: {
+                    axiscope: expect.objectContaining({ check_tool: 2, confirmed_tools: [0] }),
+                    toolhead: expect.any(Object),
+                    toolchanger: { tool_number: 2 },
+                },
+            })
+        )
+        expect(context.statusLoaded).toBe(true)
+    })
+
+    it('requeries status when the connection becomes ready', () => {
+        const context = { ...freshPage(), refreshStatus: vi.fn().mockResolvedValue(undefined) }
+        options.methods.onReady.call(context, true)
+        expect(context.refreshStatus).toHaveBeenCalledOnce()
+        options.methods.onReady.call(context, false)
+        expect(context.statusLoaded).toBe(false)
+        expect(context.statusRequest).toBe(1)
+    })
+
+    it('ignores an old query response after disconnect and does not unlock confirmation on query failure', async () => {
+        const context = freshPage()
+        let resolve: (value: unknown) => void = () => {}
+        context.$socket.emitAndWait.mockReturnValue(
+            new Promise((done) => {
+                resolve = done
+            }) as any
+        )
+        const pending = options.methods.refreshStatus.call(context)
+        context.statusRequest++
+        resolve({ status: {} })
+        await pending
+        expect(context.$store.dispatch).not.toHaveBeenCalled()
+        expect(context.statusLoaded).toBe(false)
+        context.$socket.emitAndWait.mockRejectedValue({ message: 'Disconnected' })
+        await options.methods.refreshStatus.call(context)
+        expect(context.error).toBe('Disconnected')
+        expect(context.statusLoaded).toBe(false)
+    })
+
+    it('recovers the selected camera and reference from printer GUI settings after reload', () => {
+        const context = freshPage()
+        expect(options.computed.cameraName.get.call(context)).toBe('Calibration camera')
+        expect(options.computed.capturedCameraName.get.call(context)).toBe('Calibration camera')
+        options.methods.rememberCamera.call(context, 'Another camera')
+        expect(context.$store.dispatch).toHaveBeenCalledWith('gui/setCurrentWebcam', {
+            page: 'toolcalibration-reference',
+            value: 'Another camera',
+        })
+    })
+})
diff --git a/tests/proforge.spec.ts b/tests/proforge.spec.ts
new file mode 100644
index 0000000..62813c5
--- /dev/null
+++ b/tests/proforge.spec.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it, vi } from 'vitest'
+import { filamentCommand, proforgeActiveTool, proforgeTools, PrinterObjects } from '../src/plugins/proforge'
+import ToolItem from '../src/components/panels/Toolchanger/ToolchangerPanelToolsItem.vue'
+import StartPrint from '../src/components/dialogs/StartPrintDialogToolchanger.vue'
+import ExtruderTool from '../src/components/panels/Extruder/ExtruderControlPanelToolsItem.vue'
+
+function stock(count = 5): PrinterObjects {
+    const printer: PrinterObjects = {
+        save_variables: { variables: { active_tools: count } },
+        'gcode_macro DOCK': {},
+        'gcode_button carriage_tool_sensor': { state: 'RELEASED' },
+    }
+    for (let tool = 0; tool < 5; tool++) {
+        printer[`gcode_macro SELECT_PH${tool + 1}`] = {}
+        printer[`gcode_macro T${tool}`] = {}
+        printer[`gcode_button t${tool}_dock_sensor`] = { state: 'PRESSED' }
+        for (const operation of ['LOAD', 'UNLOAD']) printer[`gcode_macro _FILAMENT_${operation}_INIT_${tool}`] = {}
+    }
+    return printer
+}
+
+describe('stock ProForge physical tools and Smart Orbiter 3', () => {
+    it.each([1, 2, 3, 4, 5])('honors %i configured heads despite five T macros', (count) => {
+        expect(proforgeTools(stock(count))).toEqual(Array.from({ length: count }, (_, n) => n))
+    })
+    it.each([0, 1, 2, 3, 4])('routes physical tool %i to one-based pickup and its own sensor macros', (tool) => {
+        const component = ToolItem as unknown as { options: any }
+        const printer = stock()
+        const context = { isProforge: true, toolNumber: tool, $store: { state: { printer } }, doSend: vi.fn() }
+        expect(component.options.computed.tCommand.get.call(context)).toBe(`SELECT_PH${tool + 1}`)
+        component.options.methods.loadFilament.call(context)
+        component.options.methods.unloadFilament.call(context)
+        expect(context.doSend.mock.calls).toEqual([
+            [`_FILAMENT_LOAD_INIT_${tool}`], [`_FILAMENT_UNLOAD_INIT_${tool}`],
+        ])
+        const extruderComponent = ExtruderTool as unknown as { options: any }
+        const extruderContext = { name: `T${tool}`, $store: { state: { printer } }, doSend: vi.fn() }
+        extruderComponent.options.methods.changeTool.call(extruderContext)
+        expect(extruderContext.doSend).toHaveBeenCalledWith(`SELECT_PH${tool + 1}`)
+    })
+    it('never reports the activated extruder as a physically mounted head', () => {
+        const printer = stock()
+        printer.toolhead = { extruder: 'extruder3' }
+        expect(proforgeActiveTool(printer)).toBe(-1)
+        printer['gcode_button carriage_tool_sensor'].state = 'PRESSED'
+        expect(proforgeActiveTool(printer)).toBe(-1)
+        printer['gcode_button t2_dock_sensor'].state = 'RELEASED'
+        expect(proforgeActiveTool(printer)).toBe(2)
+        printer['gcode_button t3_dock_sensor'].state = 'RELEASED'
+        expect(proforgeActiveTool(printer)).toBe(-1)
+        delete printer['gcode_button t3_dock_sensor']
+        expect(proforgeActiveTool(printer)).toBe(-1)
+    })
+    it('does not recognize ordinary Klipper, RatOS or native toolchangers as ProForge', () => {
+        for (const printer of [{}, { extruder: {} }, { 'gcode_macro T0': {} },
+            { ...stock(), toolchanger: { tool_names: ['tool T0'] } }]) {
+            expect(proforgeTools(printer)).toEqual([])
+            expect(filamentCommand(printer, 0, 'load')).toBe('LOAD_FILAMENT TOOLHEAD=0')
+            expect(filamentCommand(printer, 0, 'unload')).toBe('UNLOAD_FILAMENT TOOLHEAD=0')
+        }
+        const component = ToolItem as unknown as { options: any }
+        expect(component.options.computed.tCommand.get.call({ isProforge: false, toolNumber: 3 })).toBe('T3')
+    })
+    it('rejects missing or invalid capability data', () => {
+        for (const count of [0, 6, 2.5, NaN]) expect(proforgeTools(stock(count))).toEqual([])
+        const printer = stock()
+        delete printer['gcode_macro SELECT_PH3']
+        expect(proforgeTools(printer)).toEqual([])
+        const incomplete = stock()
+        delete incomplete['gcode_macro _FILAMENT_LOAD_INIT_2']
+        expect(filamentCommand(incomplete, 2, 'load')).toBe('')
+        expect(filamentCommand(stock(2), 4, 'load')).toBe('')
+    })
+    it('does not offer unsupported tool remapping on stock ProForge', () => {
+        const component = StartPrint as unknown as { options: any }
+        const visibleFilaments = [{}, {}]
+        expect(component.options.computed.hasVisibleFilaments.get.call({ isProforge: true, visibleFilaments })).toBe(false)
+        expect(component.options.computed.hasVisibleFilaments.get.call({ isProforge: false, visibleFilaments })).toBe(true)
+    })
+})
