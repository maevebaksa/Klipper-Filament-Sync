+    margin: 12px auto;
+}
+
+.filament-field,
+.filament-temperatures {
+    width: 80%;
+}
+
+.tool-buttons {
+    display: flex;
+    flex-direction: column;
+    gap: 5px;
+    margin: 10%;
+}
+
+@media (orientation: portrait) {
+    .toolchanger-tool {
+        margin: 4px;
+        border-radius: 4px;
+    }
+
+    .single-filament .filament-info {
+        display: grid;
+        grid-template-columns: 80px minmax(0, 1fr);
+        column-gap: 12px;
+        width: 100%;
+        padding: 0 12px 8px;
+    }
+
+    .single-filament .spool-control {
+        grid-row: 1 / 3;
+        grid-column: 1;
+        align-self: start;
+    }
+
+    .single-filament .filament-field,
+    .single-filament .filament-temperatures {
+        grid-column: 2;
+        width: 100%;
+    }
+}
+</style>
diff --git a/src/components/panels/ToolchangerPanel.vue b/src/components/panels/ToolchangerPanel.vue
